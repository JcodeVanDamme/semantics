@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# --- NAMESPACES ---
@prefix ont: <http://semantics.rdf.system.ontology/> .
@prefix data: <http://semantics.rdf.system.data/> .

# ==============================================================================
# SCHEMA DEFINITIONS (T-Box)
# ==============================================================================

ont:Place a owl:Class ;
    rdfs:label "Place" .

ont:State a owl:Class ;
    rdfs:subClassOf ont:Place ;
    rdfs:label "State" .

ont:Region a owl:Class ;
    rdfs:subClassOf ont:Place ;
    rdfs:label "Region" .

ont:Person a owl:Class ;
    rdfs:label "Person" .

ont:Ruler a owl:Class ;
    rdfs:subClassOf ont:Person ;
    rdfs:label "Ruler" .

ont:hasRuler a owl:ObjectProperty ;
    rdfs:domain ont:State ;
    rdfs:range ont:Ruler .

ont:formerRuler a owl:ObjectProperty ;
    rdfs:domain ont:State ;
    rdfs:range ont:Ruler .

ont:locatedIn a owl:ObjectProperty ;
    rdfs:domain ont:Region ;
    rdfs:range ont:State .

ont:mediatized a owl:ObjectProperty ;
    rdfs:domain ont:State ;
    rdfs:range ont:State .
	
ont:isActive a owl:DatatypeProperty ;
    rdfs:label "is active" ;
    rdfs:domain ont:State ;
    rdfs:range xsd:boolean .

ont:population a owl:DatatypeProperty ;
    rdfs:domain ont:Place ;
    rdfs:range xsd:integer .

ont:stateType a owl:DatatypeProperty ;
    rdfs:domain ont:State ;
    rdfs:range xsd:string .
	
ont:regionType a owl:DatatypeProperty ;
    rdfs:label "region type" ;
    rdfs:domain ont:Region ;
    rdfs:range xsd:string .

ont:isOriginalState a owl:DatatypeProperty ;
    rdfs:domain ont:State ;
    rdfs:range xsd:boolean .

ont:rulerTitle a owl:DatatypeProperty ;
    rdfs:domain ont:Ruler ;
    rdfs:range xsd:string .

# --- STATE 1: Kingdom of Prussia ---
data:State_Prussia a ont:State ;
    rdfs:label "Kingdom of Prussia" ;
    ont:hasRuler data:Ruler_WilhelmI ;
    ont:population 18491000 ;
    ont:stateType "Kingdom" ;
    ont:isOriginalState true ;
    ont:isActive true ;
	ont:mediatized data:State_Anhalt .

# --- STATE 2: Kingdom of Bavaria ---
data:State_Bavaria a ont:State ;
    rdfs:label "Kingdom of Bavaria" ;
    ont:hasRuler data:Ruler_LudwigII ;
    ont:population 4800000 ;
    ont:stateType "Kingdom" ;
    ont:isOriginalState true ;
    ont:isActive true .

# --- STATE 3: Kingdom of Saxony ---
data:State_Saxony a ont:State ;
    rdfs:label "Kingdom of Saxony" ;
    ont:hasRuler data:Ruler_Johann ;
    ont:population 2400000 ;
    ont:stateType "Kingdom" ;
    ont:isOriginalState true ;
    ont:isActive true .

# --- STATE 4: Kingdom of Württemberg ---
data:State_Wuerttemberg a ont:State ;
    rdfs:label "Kingdom of Württemberg" ;
    ont:hasRuler data:Ruler_KarlI ;
    ont:population 1800000 ;
    ont:stateType "Kingdom" ;
    ont:isOriginalState true ;
    ont:isActive true .

# --- STATE 5: Grand Duchy of Baden ---
data:State_Baden a ont:State ;
    rdfs:label "Grand Duchy of Baden" ;
    ont:hasRuler data:Ruler_FriedrichI ;
    ont:population 1400000 ;
    ont:stateType "Grand Duchy" ;
    ont:isOriginalState true ;
    ont:isActive true .

# --- STATE 6: Grand Duchy of Hesse ---
data:State_Hesse a ont:State ;
    rdfs:label "Grand Duchy of Hesse" ;
    ont:hasRuler data:Ruler_LudwigIII ;
    ont:population 850000 ;
    ont:stateType "Grand Duchy" ;
    ont:isOriginalState true ;
    ont:isActive true .

# --- STATE 7: Grand Duchy of Mecklenburg-Schwerin ---
data:State_Mecklenburg a ont:State ;
    rdfs:label "Grand Duchy of Mecklenburg-Schwerin" ;
    ont:hasRuler data:Ruler_FriedrichFrancisII ;
    ont:population 560000 ;
    ont:stateType "Grand Duchy" ;
    ont:isOriginalState true ;
    ont:isActive true .

# --- STATE 8: Grand Duchy of Oldenburg ---
data:State_Oldenburg a ont:State ;
    rdfs:label "Grand Duchy of Oldenburg" ;
    ont:hasRuler data:Ruler_PeterII ;
    ont:population 315000 ;
    ont:stateType "Grand Duchy" ;
    ont:isOriginalState true ;
    ont:isActive true .

# --- STATE 9: Duchy of Anhalt (Annexed) ---
data:State_Anhalt a ont:State ;
    rdfs:label "Duchy of Anhalt" ;
    ont:hasRuler data:Ruler_WilhelmI ;
    ont:formerRuler data:Ruler_LeopoldIV ;
    ont:population 200000 ;
    ont:stateType "Duchy" ;
    ont:isOriginalState false ;
    ont:isActive false .

# --- STATE 10: Kingdom of Hanover ---
data:State_Hanover a ont:State ;
    rdfs:label "Kingdom of Hanover" ;
    ont:hasRuler data:Ruler_GeorgeV ;
    ont:population 1900000 ;
    ont:stateType "Kingdom" ;
    ont:isOriginalState false ;
    ont:isActive true .

# ==============================================================================
# RULER DEFINITIONS
# ==============================================================================

data:Ruler_WilhelmI a ont:Ruler ;
    rdfs:label "Wilhelm I" ;
    ont:rulerTitle "King of Prussia" .

data:Ruler_LudwigII a ont:Ruler ;
    rdfs:label "Ludwig II" ;
    ont:rulerTitle "King of Bavaria" .

data:Ruler_Johann a ont:Ruler ;
    rdfs:label "Johann" ;
    ont:rulerTitle "King of Saxony" .

data:Ruler_KarlI a ont:Ruler ;
    rdfs:label "Karl I" ;
    ont:rulerTitle "King of Württemberg" .

data:Ruler_FriedrichI a ont:Ruler ;
    rdfs:label "Friedrich I" ;
    ont:rulerTitle "Grand Duke of Baden" .

data:Ruler_LudwigIII a ont:Ruler ;
    rdfs:label "Ludwig III" ;
    ont:rulerTitle "Grand Duke of Hesse" .

data:Ruler_FriedrichFrancisII a ont:Ruler ;
    rdfs:label "Friedrich Francis II" ;
    ont:rulerTitle "Grand Duke of Mecklenburg-Schwerin" .

data:Ruler_PeterII a ont:Ruler ;
    rdfs:label "Peter II" ;
    ont:rulerTitle "Grand Duke of Oldenburg" .

data:Ruler_LeopoldIV a ont:Ruler ;
    rdfs:label "Leopold IV" ;
    ont:rulerTitle "Duke of Anhalt" .

data:Ruler_GeorgeV a ont:Ruler ;
    rdfs:label "George V" ;
    ont:rulerTitle "King of Hanover" .
	
